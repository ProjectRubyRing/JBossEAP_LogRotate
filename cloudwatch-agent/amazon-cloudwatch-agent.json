            "log_group_name": "/ecs/jbosseap/back/error",
            "log_stream_name": "back/error/{hostname}",
            "timestamp_format": "%Y-%m-%d %H:%M:%S.%f%z",
            "timezone": "Local",
            "multi_line_start_pattern": "{timestamp_format}",
            "encoding": "utf-8",
            "retention_in_days": 90,
            "auto_removal": false
          },
          {
            "file_path": "/mnt/logs/back-svc/*/tracelog",
            "log_group_name": "/ecs/jbosseap/back/trace",
            "log_stream_name": "back/trace/{hostname}",
            "timestamp_format": "%Y-%m-%d %H:%M:%S.%f%z",
            "timezone": "Local",
            "multi_line_start_pattern": "{timestamp_format}",
            "encoding": "utf-8",
