            "encoding": "utf-8",
            "retention_in_days": 90,
            "auto_removal": false
          },
          {
            "file_path": "/mnt/logs/back-svc/*/io.log",
            "log_group_name": "/ecs/jbosseap/back/io",
            "log_stream_name": "back/io/{hostname}",
            "timestamp_format": "%Y-%m-%d %H:%M:%S.%f%z",
            "timezone": "Local",
